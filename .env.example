# NEPS Data Platform — ETL configuration
# Copy to .env for local development

APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://neps:neps_password@localhost:5432/neps_db

# REDCap — development (mock replaces production REDCap)
REDCAP_API_URL=http://localhost:8000/api/redcap
REDCAP_API_TOKEN=mock_token_for_development_only
REDCAP_MOCK_ENABLED=true
REDCAP_PROJECT_ID=NEPS-2025

# REDCap — production (uncomment when real credentials are available)
# REDCAP_API_URL=https://kcird.org/api/
# REDCAP_API_TOKEN_FILE=/run/secrets/redcap_api_token
# REDCAP_MOCK_ENABLED=false

# Independent REDCap -> durable source intake. No NDS registration/consent needed.
# Configure approved project/DAG source rights and storage destination first.
# REDCAP_MOCK_ENABLED=false and HTTPS environment-managed API token are required.
SOURCE_INTAKE_ENABLED=false
SOURCE_DESTINATION=
SOURCE_SERVICE_IDENTITY=
# Auto preserves native event/repeat identifiers if the project changes mode.
# Strict classic/longitudinal may be pinned only when explicitly required.
SOURCE_EVENT_MODE=auto
# Existing Ofelia sync --full dispatches to source intake when enabled.
# Explicit alternative: python -m etl.main collect-source
# Create/review additive intake schema before enabling; startup never migrates DB.
# Explicit approved application schema for V3.1 tables and Alembic history.
# Provision/review it before migration. Existing schemas/history are never moved.
# WAREHOUSE_SCHEMA=neps_source
